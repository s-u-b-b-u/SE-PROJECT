{
  "name": "bikers-portal",
  "version": "1.0.0",
  "description": "Bikers Portal — discover rides, host group journeys and find riders across India.",
  "main": "server/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "db:schema": "node database/run-sql.js database/schema.sql",
    "db:seed": "node database/seed.js",
    "db:locations": "node database/import-locations.js",
    "test": "node --test tests/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "mysql2": "^3.11.4"
  }
}
