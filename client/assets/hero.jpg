<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1a1a1a"/>
      <stop offset="60%" stop-color="#2a2a2a"/>
      <stop offset="100%" stop-color="#3a3a3a"/>
    </linearGradient>
    <linearGradient id="mountGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4a4a4a"/>
      <stop offset="100%" stop-color="#1f1f1f"/>
    </linearGradient>
    <linearGradient id="roadGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#333333"/>
      <stop offset="100%" stop-color="#121212"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#skyGrad)"/>
  <!-- Mountain silhouettes -->
  <polygon points="0,550 250,280 500,550" fill="url(#mountGrad)" opacity="0.6"/>
  <polygon points="300,550 650,220 1000,550" fill="url(#mountGrad)" opacity="0.8"/>
  <polygon points="750,550 1050,300 1200,550" fill="url(#mountGrad)" opacity="0.7"/>
  <!-- Ground -->
  <rect y="520" width="1200" height="280" fill="#181818"/>
  <!-- Winding highway -->
  <path d="M 600,520 Q 560,620 400,800 L 800,800 Q 640,620 600,520 Z" fill="url(#roadGrad)"/>
  <path d="M 600,520 Q 580,620 590,800" stroke="#f5f5f5" stroke-dasharray="24,20" stroke-width="6" fill="none"/>
  <!-- Rider Silhouette Icon -->
  <g transform="translate(560, 560) scale(0.6)" fill="#ffffff">
    <circle cx="50" cy="20" r="14"/>
    <path d="M25,55 L45,35 L60,45 L85,40 L75,70 L55,60 L40,85 L20,80 Z"/>
    <circle cx="20" cy="85" r="16" fill="none" stroke="#ffffff" stroke-width="6"/>
    <circle cx="85" cy="85" r="16" fill="none" stroke="#ffffff" stroke-width="6"/>
  </g>
</svg>
